# Copy to .env (same folder as serve_all.py) to override any default.
# Every setting is read through the MEWS_ prefix; anything left out keeps the
# default shown here, so the app runs with no .env file at all.

# ── Application ───────────────────────────────────────────────────────────────
# Model bundle location. Default: the deployment_bundle/ beside app/
# MEWS_BUNDLE_DIR=./deployment_bundle

# SQLite by default; PostgreSQL + PostGIS in production.
# MEWS_DATABASE_URL=sqlite:///./malaria.db
# MEWS_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/malaria

# Two-stage recursive chain for interactive /predict calls.
# MEWS_ENABLE_RECURSIVE_CHAIN=true

# ── MLOps: data source ────────────────────────────────────────────────────────
# open_meteo | nasa_power | csv   — swapping the source needs no code change.
# MEWS_CLIMATE_SOURCE=open_meteo

# Used only when MEWS_CLIMATE_SOURCE=csv. This is the intended entry point for
# the IoT acquisition layer (see iot_acquisition/).
# MEWS_CSV_SOURCE_PATH=./data/incoming

# Months of history collected per run (>= 3, the climate lags need it).
# MEWS_LOOKBACK_MONTHS=6

# ── MLOps: scheduling ─────────────────────────────────────────────────────────
# Autonomous pipeline trigger at application startup. Off by default.
# MEWS_SCHEDULER_ENABLED=false

# 2nd of each month at 03:00 — gives the ERA5 reanalysis time to publish.
# MEWS_SCHEDULE_CRON=0 3 2 * *

# Comma-separated districts; empty means every district in the bundle.
# MEWS_SCHEDULED_DISTRICTS=

# ── MLOps: quality and drift ──────────────────────────────────────────────────
# MEWS_MAX_NULL_RATE=0.05
# MEWS_PSI_MAJOR_THRESHOLD=0.25
# MEWS_PERF_DRIFT_TOLERANCE=1.5
# MEWS_PERF_DRIFT_WINDOW=6

# ── MLOps: retraining ─────────────────────────────────────────────────────────
# MEWS_RETRAIN_ON_MAJOR_DRIFT=true
# MEWS_RETRAIN_MIN_NEW_MONTHS=12
# MEWS_REGISTRY_DIR=./model_registry
