# ──────────────────────────────────────────────────────────────────────────────
# Not published with this repository
# ──────────────────────────────────────────────────────────────────────────────
# Internal working documents and the thesis LaTeX sources are kept private.
# The thesis itself is published as docs/memoirthesis.pdf.
internal_docs/
thesis_text/

# ──────────────────────────────────────────────────────────────────────────────
# Generated output — rebuilt by the notebooks, never committed
# ──────────────────────────────────────────────────────────────────────────────
# figure_regeneration/generate_all_figures.ipynb writes here (Run All, ~11 min).
# The originals in figures/thesis_figures/ ARE committed, for comparison.
figures/regenerated/*
!figures/regenerated/.gitkeep

# CatBoost training logs
catboost_info/

# ──────────────────────────────────────────────────────────────────────────────
# Application runtime state
# ──────────────────────────────────────────────────────────────────────────────
# SQLite database created on first run of webapp/serve_all.py
*.db
*.db-journal
*.sqlite
*.sqlite3

